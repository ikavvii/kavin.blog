# ---------------------------------------------------------------------------
# Terminal Blog/CMS — environment configuration
# Copy this file to `.env.local` and adjust the values.
# ---------------------------------------------------------------------------

# Password that protects the /admin area and write APIs.
# Leave empty to disable the login gate (handy for local development only).
ADMIN_PASSWORD=changeme

# Secret used to sign the session cookie. Set a long random string in production.
# If omitted, a value derived from ADMIN_PASSWORD is used.
ADMIN_SECRET=

# Where posts, settings and uploaded media are stored.
# Defaults to ./data relative to the project root.
# DATA_DIR=./data

# Maximum upload size in megabytes.
# MAX_UPLOAD_MB=25
